{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "live-sat-location",
  "compatibility_date": "2026-07-18",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // CelesTrak publishes every two hours. Stored catalogs keep cold regions instant.
  "triggers": { "crons": ["17 */2 * * *"] },
  "kv_namespaces": [{ "binding": "CATALOG", "id": "53da7899c67e4300bbe9c8890c66da54" }]
}
